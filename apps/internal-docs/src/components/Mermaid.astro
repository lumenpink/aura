---
interface Props {
  code: string;
}

const { code } = Astro.props;
---

<div class="mermaid-container my-8 p-6 bg-zinc-900/5 dark:bg-zinc-100/5 rounded-2xl border border-zinc-200/40 dark:border-zinc-800/40 overflow-x-auto shadow-xs">
  <pre class="mermaid-code" style="display: none;">{code}</pre>
  <div class="mermaid-target flex justify-center"></div>
</div>

<script is:inline>
  (function () {
    function renderAllDiagrams() {
      const isDark =
        document.documentElement.getAttribute('data-theme') === 'dark' ||
        document.documentElement.classList.contains('dark');

      window.mermaid.initialize({
        startOnLoad: false,
        theme: isDark ? 'dark' : 'default',
        securityLevel: 'loose',
        themeVariables: {
          background: isDark ? '#09090b' : '#fafafa',
          primaryColor: '#8b5cf6',
          primaryTextColor: isDark ? '#f4f4f5' : '#202023',
          lineColor: '#8b5cf6',
          actorBorder: '#8b5cf6',
          actorBkg: isDark ? '#1e1b4b' : '#ede9fe',
          signalColor: isDark ? '#f4f4f5' : '#202023',
          signalLineColor: '#8b5cf6',
        },
      });

      const containers = document.querySelectorAll('.mermaid-container');
      containers.forEach((container, index) => {
        const codeEl = container.querySelector('.mermaid-code');
        const targetEl = container.querySelector('.mermaid-target');
        
        if (codeEl && targetEl && !targetEl.querySelector('svg')) {
          const codeText = codeEl.textContent || '';
          const uniqueId = `mermaid-svg-${index}-${Math.floor(Math.random() * 100000)}`;

          try {
            window.mermaid
              .render(uniqueId, codeText.trim())
              .then((result) => {
                targetEl.innerHTML = result.svg;
              })
              .catch((err) => {
                console.error('[Mermaid] render promise error:', err);
                targetEl.innerHTML = `
                  <div class="p-4 bg-red-500/10 border border-red-500/30 rounded-xl text-left">
                    <p class="text-xs font-semibold text-red-500">Erro ao renderizar diagrama:</p>
                    <pre class="text-[10px] text-red-400 mt-2 overflow-x-auto">${err.message || err}</pre>
                  </div>
                `;
              });
          } catch (e) {
            console.error('[Mermaid] render sync error:', e);
          }
        }
      });
    }

    function initMermaid() {
      if (window.mermaid) {
        renderAllDiagrams();
      } else {
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/mermaid@10.9.1/dist/mermaid.min.js';
        script.async = true;
        script.onload = renderAllDiagrams;
        document.body.appendChild(script);
      }
    }

    // Run on initial load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMermaid);
    } else {
      initMermaid();
    }

    // Support client-side navigation/theme toggle changes if Starlight uses them
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.attributeName === 'data-theme' || mutation.attributeName === 'class') {
          // Re-render when theme changes
          if (window.mermaid) {
            renderAllDiagrams();
          }
        }
      });
    });
    observer.observe(document.documentElement, { attributes: true });
  })();
</script>
