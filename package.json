{
  "name": "aura",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:frontend": "bun --env-file=.env.local --cwd apps/frontend dev --port 12201 --strictPort",
    "dev:backend": "bun --env-file=.env.local --cwd apps/backend dev --port 12202",
    "dev": "concurrently -n \"front,back\" -c \"blue,magenta\" \"bun dev:frontend\" \"bun dev:backend\"",
    "test": "bun test",
    "test:shared": "bun test test/shared",
    "test:backend": "bun test test/backend",
    "test:frontend": "bun test test/frontend",
    "pdf:docs": "bun run scripts/generate-pdf.ts"
  },
  "dependencies": {
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "lucide-react": "^1.17.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "hono": "^4.12.23"
  }
}