# === Aura Monorepo: Environment Variables Template ===
# Copy this file to '.env.local' and adjust the values for your environment.

# --- Aura Fluxo (Clínica) ---
# VITE_FLUXO_API_URL=https://fluxo-api.clinicaexemplo.com.br # Opcional (Padrão: http://fluxo-api.localhost:12202)
# ALLOWED_ORIGINS_FLUXO=https://fluxo.clinica eclinicaexemplo.com.br # Opcional (Padrão: http://fluxo.localhost:12201)

# --- Aura Traço (Assinatura) ---
# VITE_TRACO_API_URL=https://traco-api.clinicaexemplo.com.br # Opcional (Padrão: http://traco-api.localhost:12302)
# ALLOWED_ORIGINS_TRACO=https://traco.clinica eclinicaexemplo.com.br # Opcional (Padrão: http://traco.localhost:12301)

# --- Aura Pulso (Receituário) ---
# VITE_PULSO_API_URL=https://pulso-api.clinicaexemplo.com.br # Opcional (Padrão: http://pulso-api.localhost:12402)
# ALLOWED_ORIGINS_PULSO=https://pulso.clinica eclinicaexemplo.com.br # Opcional (Padrão: http://pulso.localhost:12401)

# --- Configurações Gerais de Criptografia ---
# Chave secreta criptográfica para validação local de JWT
JWT_SECRET=sua_chave_secreta_jwt_aqui
# Domínio da API principal (se necessário)
API_DOMAIN=api.clinicaexemplo.com.br
