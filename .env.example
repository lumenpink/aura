# === Aura Monorepo: Environment Variables Template ===
# Copy this file to '.env.local' and adjust the values for your environment.

# --- Frontend Configurations (Vite) ---
# The public HTTPS URL where the frontend is exposed (e.g. Cloudflare Tunnel or production url)
VITE_APP_URL=https://app.aura.2lp.in

# The API Gateway URL pointing to Hono on Cloudflare Workers
VITE_API_URL=https://api.aura.2lp.in

# Dedicated auth subdomain for secure cookie scope isolation
VITE_AUTH_URL=https://auth.aura.2lp.in

# --- Backend Configurations (Wrangler / Cloudflare Workers) ---
# CORS origins permitted to make requests to the backend API (comma-separated if multiple)
ALLOWED_ORIGINS=https://app.aura.2lp.in

# Root domain scope for HttpOnly cookies (SameSite validation)
COOKIE_DOMAIN=aura.2lp.in

# Cryptographically secure secret key for JWT verification (Access & Refresh tokens)
JWT_SECRET=your_jwt_secret_here

# Domain names for routing validation (without protocol, e.g. auth.aura.2lp.in)
AUTH_DOMAIN=auth.aura.2lp.in
API_DOMAIN=api.aura.2lp.in
